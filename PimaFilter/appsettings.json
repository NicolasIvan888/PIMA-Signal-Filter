{
  "PimaFilter": {
    "Mode": "Monitor",
    "BindAddress": "127.0.0.1",
    "MaxConcurrentConnections": 256,
    "ClientReadTimeoutSeconds": 10,
    "UpstreamConnectTimeoutSeconds": 3,
    "UpstreamAckTimeoutSeconds": 4,
    "MaxFrameBytes": 512,
    "BlacklistFile": "data/config/blacklist.json",
    "Routes": [],
    "Diagnostics": {
      "LogDirectory": "data/logs",
      "StatusFile": "data/status.json",
      "StatusIntervalSeconds": 5,
      "AllowedRetentionDays": 1,
      "BlockedRetentionDays": 7,
      "ErrorRetentionDays": 30,
      "InvalidRetentionDays": 7,
      "AllowedLogEveryN": 1000,
      "BlockedLogEveryN": 100,
      "ErrorLogEveryN": 1
    }
  }
}
